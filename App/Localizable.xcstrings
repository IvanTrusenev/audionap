        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключать только на батарейке"
          }
        }
      }
    },
    "settings.timeoutValue %@ %lld": {
      "comment": "A slider label: the first argument is the setting's title, the second is its current value in minutes.",
