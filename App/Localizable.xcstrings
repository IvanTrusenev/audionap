    "device.empty": {
      "comment": "Shown when blueutil reports no paired devices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет парных устройств"
          }
        }
      }
    },
