          }
        }
      }
    },
    "settings.speakerOnBattery": {
      "comment": "The toggle that limits disconnects to battery-powered speakers: off means the speaker is on wall power and is never disconnected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect only while on battery"
