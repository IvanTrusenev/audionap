    "error.autostart.title": {
      "comment": "The title of an alert that appears when the app can't update the launch-at-login plist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autostart error"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка автозапуска"
          }
        }
      }
    },
    "error.blueutilNotFound": {
      "comment": "Shown when the blueutil binary is not installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueutil is not installed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "blueutil не установлен."
          }
        }
      }
    },
    "error.bootoutFailed %lld": {
      "comment": "Shown when the daemon could not be stopped; the argument is the launchctl exit code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not stop the daemon (launchctl exited with code %1$lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось остановить демон (launchctl завершился с кодом %1$lld)."
          }
        }
      }
    },
    "error.bootstrapFailed %lld": {
      "comment": "Shown when the daemon could not be started; the argument is the launchctl exit code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the daemon (launchctl exited with code %1$lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить демон (launchctl завершился с кодом %1$lld)."
          }
        }
      }
    },
    "error.connectFailed %lld": {
      "comment": "Shown when blueutil could not reconnect the device; the argument is the exit code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect the device (blueutil exited with code %1$lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключить устройство (blueutil завершился с кодом %1$lld)."
          }
        }
      }
    },
    "error.daemonInstall.bundledMissing": {
      "comment": "Error message when the bundled daemon is missing.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled daemon is missing from the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демон не найден в составе приложения."
          }
        }
      }
    },
    "error.daemonInstall.title": {
      "comment": "The title of an alert that appears when the app can't install the daemon.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daemon install error"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка установки демона"
          }
        }
      }
    },
    "error.disconnectFailed %lld": {
      "comment": "Shown when blueutil could not disconnect the device; the argument is the exit code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disconnect the device (blueutil exited with code %1$lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить устройство (blueutil завершился с кодом %1$lld)."
          }
        }
      }
    },
